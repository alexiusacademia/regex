// regex: character classes. A class is a list of code point ranges, low
// and high in turn ([48, 57, 97, 122] is 0-9 and a-z), sorted and with no
// two ranges touching, so a code point is looked up by binary search.
//
// Author: Alexius Academia
// Date: 2026-10-24

// The largest code point.
let maxCodePoint = 1114111

// The ranges sorted, with overlapping and touching ones merged.
fn normalized(_ ranges: [Int]) -> [Int] {
    var pairs: [(Int, Int)] = []
    var k = 0
    while k + 1 < ranges.count {
        let lo = min(ranges[k], ranges[k + 1])
        let hi = max(ranges[k], ranges[k + 1])
        pairs.append((lo, hi))
        k += 2
    }
    let sorted = pairs.sorted(by: { a, b in a.0 < b.0 })
    var out: [Int] = []
    for (lo, hi) in sorted {
        let n = out.count
        if n >= 2 && lo <= out[n - 1] + 1 {
            out[n - 1] = max(out[n - 1], hi)
        } else {
            out.append(lo)
            out.append(hi)
        }
    }
    out
}

// Every code point the (normalized) ranges don't have.
fn negated(_ ranges: [Int]) -> [Int] {
    var out: [Int] = []
    var next = 0
    var k = 0
    while k + 1 < ranges.count {
        if ranges[k] > next {
            out.append(next)
            out.append(ranges[k] - 1)
        }
        next = ranges[k + 1] + 1
        k += 2
    }
    if next <= maxCodePoint {
        out.append(next)
        out.append(maxCodePoint)
    }
    out
}

// The ranges with the other case of every letter in them added.
fn caseFolded(_ ranges: [Int]) -> [Int] {
    // The blocks where otherCases knows letters.
    let blocks = [65, 90, 97, 122, 192, 383, 913, 969, 1024, 1119]
    var out = ranges
    var k = 0
    while k + 1 < ranges.count {
        var b = 0
        while b + 1 < blocks.count {
            let lo = max(ranges[k], blocks[b])
            let hi = min(ranges[k + 1], blocks[b + 1])
            var c = lo
            while c <= hi {
                for o in otherCases(c) {
                    out.append(o)
                    out.append(o)
                }
                c += 1
            }
            b += 2
        }
        k += 2
    }
    normalized(out)
}

// Whether the (normalized) ranges have the code point c.
fn classHas(_ ranges: [Int], _ c: Int) -> Bool {
    var lo = 0
    var hi = ranges.count / 2 - 1
    while lo <= hi {
        let mid = (lo + hi) / 2
        if c < ranges[2 * mid] {
            hi = mid - 1
        } else if c > ranges[2 * mid + 1] {
            lo = mid + 1
        } else {
            return true
        }
    }
    false
}

// \d: the ASCII digits.
fn digitRanges() -> [Int] {
    [48, 57]
}

// \w: ASCII letters, digits and _.
fn wordRanges() -> [Int] {
    [48, 57, 65, 90, 95, 95, 97, 122]
}

// \s: space, tab, line feed, vertical tab, form feed and carriage return.
fn spaceRanges() -> [Int] {
    [9, 13, 32, 32]
}

// The ranges of a POSIX class like `alpha` (from [[:alpha:]]), or [] for a
// name that isn't one.
fn posixRanges(_ name: String) -> [Int] {
    if name == "alnum" {
        return [48, 57, 65, 90, 97, 122]
    }
    if name == "alpha" {
        return [65, 90, 97, 122]
    }
    if name == "ascii" {
        return [0, 127]
    }
    if name == "blank" {
        return [9, 9, 32, 32]
    }
    if name == "cntrl" {
        return [0, 31, 127, 127]
    }
    if name == "digit" {
        return [48, 57]
    }
    if name == "graph" {
        return [33, 126]
    }
    if name == "lower" {
        return [97, 122]
    }
    if name == "print" {
        return [32, 126]
    }
    if name == "punct" {
        return [33, 47, 58, 64, 91, 96, 123, 126]
    }
    if name == "space" {
        return [9, 13, 32, 32]
    }
    if name == "upper" {
        return [65, 90]
    }
    if name == "word" {
        return wordRanges()
    }
    if name == "xdigit" {
        return [48, 57, 65, 70, 97, 102]
    }
    []
}
